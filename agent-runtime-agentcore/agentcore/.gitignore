# Secrets (local environment files are never committed)
.env.local

# CDK Build Artifacts
cdk/cdk.out/
cdk/node_modules/

# CLI Internals (deploy-tool-generated local state; never commit — contains
# account IDs, role ARNs, and local file paths from deploy/invoke logs)
.cli/

# Ephemeral Staging
.cache/*

# LLM context scaffolding (regenerated by the CLI, read-only reference docs)
.llm-context/
