# Secrets (local environment files are never committed)
.env.local

# Deployment targets (account ID + region) — derived from `aws sts
# get-caller-identity` + .env's BROWSER_REGION by deploy-dev.sh's
# ensure_agentcore_account(), not something to check in. See deploy-dev.sh.
aws-targets.json

# CDK Build Artifacts
cdk/cdk.out/
cdk/node_modules/

# CLI Internals (deploy-tool-generated local state; never commit — contains
# account IDs, role ARNs, and local file paths from deploy/invoke logs)
.cli/

# Ephemeral Staging
.cache/*

# LLM context scaffolding (regenerated by the CLI, read-only reference docs)
.llm-context/
