# Copy to .env and fill in. docker-compose reads this automatically.

# ─── App under test ───────────────────────────────────────────────────────────
# Defaults to the sample app (sample-app/), which deploy-dev.sh brings up
# alongside the testrunner on the same host. Point elsewhere if you're
# testing a different app.
TARGET_URL=http://localhost:8020

# ─── Agent mode ──────────────────────────────────────────────────────────────
# 'agentcore' = invoke AWS AgentCore Runtime (default). Requires a deployed
# AgentCore Runtime (AGENTCORE_RUNTIME_ARN below) — the backend and frontend
# Settings modal both key off this value alone (no separate enable flag).
# 'local' = run OpenCode in the agent-runtime-local container
AGENT_MODE=agentcore

# ─── Bedrock ─────────────────────────────────────────────────────────────────
BEDROCK_MODEL=global.anthropic.claude-sonnet-5
BEDROCK_REGION=us-east-1
BROWSER_REGION=ap-southeast-1
# Required when AGENT_MODE=agentcore. Set this after deploying
# agent-runtime-agentcore (see agent-runtime-agentcore/agentcore/)
# — the `agentcore deploy` command prints the resulting ARN. deploy-dev.sh
# fills this in automatically (it runs the deploy by default).
AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:<region>:<account-id>:runtime/<runtime-name>-<suffix>

# ─── S3 — evidence snapshots for Analysis ───────────────────────────────────
# Bucket must exist in S3_SNAPSHOT_REGION. The container's IAM role needs
# s3:PutObject and s3:GetObject on it. Object keys: runs/<runId>/<tcId>/<seq>.png
# Lifecycle policy on the bucket should expire objects after ~30 days.
S3_SNAPSHOT_BUCKET=your-testrunner-snapshots-bucket
S3_SNAPSHOT_REGION=ap-southeast-1
