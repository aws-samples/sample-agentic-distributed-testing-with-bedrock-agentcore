# Copy to .env and fill in. docker-compose reads this automatically.

# ─── App under test ───────────────────────────────────────────────────────────
# Defaults to the sample app (sample-app/), which deploy-local.sh brings up
# alongside the testrunner on the same host. Point elsewhere if you're
# testing a different app.
TARGET_URL=http://localhost:8020

# ─── Agent mode ──────────────────────────────────────────────────────────────
# 'local' = run OpenCode in the agent-runtime-local container
# 'agentcore' = invoke AWS AgentCore Runtime
AGENT_MODE=local

# Whether the AgentCore Runtime path is available at all. When false (the
# default for local dev), deploy-local.sh skips the AgentCore deploy step
# even if --with-agentcore is passed, the backend refuses AGENT_MODE=agentcore,
# and the frontend Settings modal hides the AgentCore Runtime option and the
# AgentCore Region field entirely. Set to true once you've deployed
# agent-runtime-agentcore (see agent-runtime-agentcore/agentcore/) and want to
# offer it as a mode.
ENABLE_AGENTCORE=false

# ─── Bedrock ─────────────────────────────────────────────────────────────────
BEDROCK_MODEL=global.anthropic.claude-sonnet-4-6
BEDROCK_REGION=us-east-1
BROWSER_REGION=ap-southeast-1
# Required only when AGENT_MODE=agentcore (and ENABLE_AGENTCORE=true). Set this
# after deploying agent-runtime-agentcore (see agent-runtime-agentcore/agentcore/)
# — the `agentcore deploy` command prints the resulting ARN.
AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:<region>:<account-id>:runtime/<runtime-name>-<suffix>

# ─── S3 — evidence snapshots for Analysis ───────────────────────────────────
# Bucket must exist in S3_SNAPSHOT_REGION. The container's IAM role needs
# s3:PutObject and s3:GetObject on it. Object keys: runs/<runId>/<tcId>/<seq>.png
# Lifecycle policy on the bucket should expire objects after ~30 days.
S3_SNAPSHOT_BUCKET=paperclip-testrunner-snapshots-ap-southeast-1
S3_SNAPSHOT_REGION=ap-southeast-1
